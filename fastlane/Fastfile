default_platform(:ios)

platform :ios do
  desc "Run unit tests suite"
  lane :test do
    UI.message("🧪 Running TinyTouch Unit Tests Suite...")
    sh("swift tools/run_tests.swift")
  end

  desc "Set an explicit build number in project configuration"
  lane :set_build do |options|
    build_num = options[:build_number] || UI.user_error!("Missing required parameter: build_number")
    UI.message("🔢 Setting build number to #{build_num}...")
    sh("python3 tools/release.py --build-number #{build_num} --no-test --dry-run")
  end

  desc "Bump project build number by 1"
  lane :bump do
    UI.message("⬆️ Bumping build number...")
    sh("python3 tools/release.py --bump --no-test --dry-run")
  end

  desc "Build universal archive (dry-run / local check without uploading)"
  lane :build do |options|
    test unless options[:skip_tests]
    
    if options[:build_number]
      set_build(build_number: options[:build_number])
    elsif options[:bump]
      bump
    end

    UI.message("📦 Building TinyTouch universal archive...")
    sh("python3 tools/release.py --no-test --dry-run")
  end

  desc "Build and upload directly to TestFlight"
  lane :beta do |options|
    # 1. Run unit tests
    test unless options[:skip_tests]

    # 2. Update build number if requested
    if options[:build_number]
      set_build(build_number: options[:build_number])
    elsif options[:bump]
      bump
    end

    # 3. Configure App Store Connect API Key
    api_key = nil
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"] || options[:key_id]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"] || options[:issuer_id]
    key_content = ENV["APP_STORE_CONNECT_KEY_P8"] || options[:key_content]
    key_path = ENV["APP_STORE_CONNECT_KEY_PATH"] || options[:key_path]

    if key_id && issuer_id && (key_content || key_path)
      UI.message("🔑 Configuring App Store Connect API Key (#{key_id})...")
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: key_content,
        key_filepath: key_path,
        in_house: false
      )
    end

    # 4. Build IPA package
    UI.message("🛠️ Archiving and packaging TinyTouch (iOS + watchOS + Widget)...")
    build_app(
      project: "ToddlerPlay.xcodeproj",
      scheme: "TinyTouch",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "TinyTouch",
      clean: true,
      export_xcargs: "-allowProvisioningUpdates",
      export_options: {
        method: "app-store",
        teamID: "6522A974B3",
        signingStyle: "automatic",
        uploadSymbols: true,
        stripSwiftSymbols: true
      }
    )

    # 5. Upload to TestFlight via pilot
    changelog_text = options[:changelog] || "TinyTouch v1.1 - Low-stimulation sensory play, Apple Watch face complication, and iPhone remote sync."
    UI.message("🚀 Uploading package to TestFlight...")
    
    upload_params = {
      ipa: "build/TinyTouch.ipa",
      skip_waiting_for_build_processing: true,
      changelog: changelog_text
    }
    upload_params[:api_key] = api_key if api_key

    upload_to_testflight(upload_params)
    UI.success("🎉 TinyTouch successfully uploaded to TestFlight!")
  end

  desc "Upload App Store metadata (descriptions, keywords, URLs, notes) to App Store Connect"
  lane :upload_metadata do |options|
    api_key = nil
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"] || options[:key_id]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"] || options[:issuer_id]
    key_content = ENV["APP_STORE_CONNECT_KEY_P8"] || options[:key_content]
    key_path = ENV["APP_STORE_CONNECT_KEY_PATH"] || options[:key_path]

    if key_id && issuer_id && (key_content || key_path)
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: key_content,
        key_filepath: key_path,
        in_house: false
      )
    end

    deliver_params = {
      skip_binary_upload: true,
      skip_screenshots: options[:skip_screenshots] || false,
      force: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots"
    }
    deliver_params[:api_key] = api_key if api_key

    deliver(deliver_params)
    UI.success("✅ App Store metadata successfully synced!")
  end
end
